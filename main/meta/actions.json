{
  "version": 2,
  "actions": [
    {
      "id": "action_build_genius_open",
      "type": "plugin_action",
      "title": "Build Genius",
      "description": "Scan the last Gradle log and fix ACSIDE sync errors. Works from the home screen.",
      "iconName": "Build",
      "showIn": ["home", "quickActions", "editorOverflow", "toolbar"],
      "priority": 1,
      "pluginConfig": {
        "pluginPath": "BuildGenius/plugin.apk",
        "className": "io.github.canadian.dev.buildgenius.BuildGeniusPlugin",
        "methodName": "setContext",
        "methodType": "static"
      }
    },
    {
      "id": "action_build_genius_quick_fix",
      "type": "plugin_action",
      "title": "Quick Fix Build",
      "description": "Read the Gradle daemon log and apply the fix (Library.getSrcJars, SDK, deps).",
      "iconName": "AutoFixHigh",
      "showIn": ["home", "quickActions", "editorOverflow"],
      "priority": 2,
      "pluginConfig": {
        "pluginPath": "BuildGenius/plugin.apk",
        "className": "io.github.canadian.dev.buildgenius.BuildGeniusPlugin",
        "methodName": "quickFix",
        "methodType": "static"
      }
    },
    {
      "id": "settings",
      "type": "plugin_action",
      "title": "Build Genius Settings",
      "description": "Open Build Genius",
      "iconName": "Settings",
      "showIn": ["pluginSettings", "home"],
      "priority": 3,
      "pluginConfig": {
        "pluginPath": "BuildGenius/plugin.apk",
        "className": "io.github.canadian.dev.buildgenius.BuildGeniusPlugin",
        "methodName": "settings",
        "methodType": "static"
      }
    }
  ]
}
